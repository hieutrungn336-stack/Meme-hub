-- 5. Teleport (Dịch chuyển tới người chơi khác)
CreateToggle("Teleport", function(state)
	if state then
		pcall(function()
			local lp = game.Players.LocalPlayer
			local target = nil
			for _, p in pairs(game.Players:GetPlayers()) do
				if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					target = p.Character.HumanoidRootPart
					break
				end
			end
			if target and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
				lp.Character.HumanoidRootPart.CFrame = target.CFrame + Vector3.new(0, 3, 0)
			end
		end)
	end
end)

-- 6. ESP Player (Nhìn xuyên tường)
CreateToggle("ESP Player", function(state)
	for _, p in pairs(game.Players:GetPlayers()) do
		if p ~= game.Players.LocalPlayer then
			if state then
				if p.Character and not p.Character:FindFirstChild("Highlight") then
					local hl = Instance.new("Highlight")
					hl.Parent = p.Character
					hl.FillColor = Color3.fromRGB(0, 255, 255)
					hl.OutlineColor = Color3.fromRGB(255, 255, 255)
				end
			else
				if p.Character and p.Character:FindFirstChild("Highlight") then
					p.Character.Highlight:Destroy()
				end
			end
		end
	end
end)

-- 7. Fly (Bay lượn)
_G.Fly = false
local bv, bg
CreateToggle("Fly", function(state)
	_G.Fly = state
	local lp = game.Players.LocalPlayer
	local char = lp.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	
	if state then
		local hrp = char.HumanoidRootPart
		bv = Instance.new("BodyVelocity", hrp)
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = Vector3.new(0, 0, 0)
		
		bg = Instance.new("BodyGyro", hrp)
		bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		
		task.spawn(function()
			while _G.Fly and char and hrp do
				task.wait()
				local cam = workspace.CurrentCamera
				bv.Velocity = cam.CFrame.LookVector * 50
				bg.CFrame = cam.CFrame
			end
		end)
	else
		if bv then bv:Destroy() end
		if bg then bg:Destroy() end
	end
end)

-- 8. Auto Block (Tự động đỡ đòn)
_G.AutoBlock = false
CreateToggle("Auto Block", function(state)
	_G.AutoBlock = state
	task.spawn(function()
		while _G.AutoBlock do
			task.wait(0.25)
			pcall(function()
				local vim = game:GetService("VirtualInputManager")
				vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
				task.wait(0.05)
				vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
			end)
		end
	end)
end)
