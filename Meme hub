-- Hàm tạo nút Bật/Tắt tối ưu cho cảm ứng điện thoại
local function CreateToggle(name, callback)
	local btn = Instance.new("TextButton")
	local corner = Instance.new("UICorner")
	
	btn.Name = name .. "Btn"
	btn.Parent = MainFrame
	btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	btn.Size = UDim2.new(0, 220, 0, 40)
	btn.Font = Enum.Font.SourceSansBold
	btn.Text = name .. ": OFF"
	btn.TextColor3 = Color3.fromRGB(255, 100, 100)
	btn.TextSize = 14
	
	corner.Parent = btn
	
	local state = false
	btn.MouseButton1Click:Connect(function()
		state = not state
		if state then
			btn.Text = name .. ": ON"
			btn.TextColor3 = Color3.fromRGB(100, 255, 100)
			btn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
		else
			btn.Text = name .. ": OFF"
			btn.TextColor3 = Color3.fromRGB(255, 100, 100)
			btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		end
		callback(state)
	end)
end

-- ==================== DANH SÁCH TÍNH NĂNG ====================

-- 1. Tàng hình (Invisibility)
CreateToggle("Tang Hinh", function(state)
	local lp = game.Players.LocalPlayer
	if lp.Character then
		for _, v in pairs(lp.Character:GetDescendants()) do
			if v:IsA("BasePart") or v:IsA("Decal") then
				v.Transparency = state and 1 or 0
			end
		end
	end
end)

-- 2. Tăng Hitbox (Hitbox Expander)
CreateToggle("Tang Hitbox", function(state)
	for _, player in pairs(game.Players:GetPlayers()) do
		if player ~= game.Players.LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = player.Character.HumanoidRootPart
			if state then
				hrp.Size = Vector3.new(6, 6, 6)
				hrp.Transparency = 0.6
				hrp.CanCollide = false
			else
				hrp.Size = Vector3.new(2, 2, 1)
				hrp.Transparency = 1
				hrp.CanCollide = false
			end
		end
	end
end)

