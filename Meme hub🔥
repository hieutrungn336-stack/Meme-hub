Instance.new("UICorner", Title).CornerRadius = UDim.new(0, 8)

-- Nút Kill All chính
local KillBtn = Instance.new("TextButton")
KillBtn.Size = UDim2.new(0.9, 0, 0, 45)
KillBtn.Position = UDim2.new(0.05, 0, 0.45, 0)
KillBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
KillBtn.TextColor3 = Color3.fromRGB(255, 69, 0)
KillBtn.TextSize = 13
KillBtn.Font = Enum.Font.GothamBold
KillBtn.Text = "⚡ KÍCH HOẠT KILL ALL"
KillBtn.Parent = MainFrame

Instance.new("UICorner", KillBtn).CornerRadius = UDim.new(0, 6)
local kStroke = Instance.new("UIStroke", KillBtn)
kStroke.Color = Color3.fromRGB(255, 69, 0)
kStroke.Thickness = 1.5

-- Hàm thực thi Kill All trực tiếp dựa vào cơ chế nhân vật
local isKilling = false
KillBtn.Activated:Connect(function()
    isKilling = not isKilling
    if isKilling then
        kStroke.Color = Color3.fromRGB(0, 255, 0)
        KillBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
        KillBtn.Text = "🟢 ĐANG CHẠY KILL ALL"
        
        task.spawn(function()
            while isKilling do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp then
                    -- Lấy tool trên tay hoặc balo
                    local tool = char:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                    if tool and tool.Parent == LocalPlayer.Backpack then
                        tool.Parent = char
                    end
                    
                    -- Tự động dịch chuyển đến ngay sau lưng từng người chơi rồi chém lập tức để server nhận diện sát thương
                    for _, player in ipairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and isKilling then
                            local eChar = player.Character
                            local eHrp = eChar and eChar:FindFirstChild("HumanoidRootPart")
                            local eHum = eChar and eChar:FindFirstChildOfClass("Humanoid")
                            
                            if eHrp and eHum and eHum.Health > 0 then
                                local oldPos = hrp.CFrame
                                -- Teleport áp sát mục tiêu trong khoảnh khắc cực ngắn
                                hrp.CFrame = eHrp.CFrame * CFrame.new(0, 0, 2)
                                if tool then
                                    pcall(function()
                                        tool:Activate()
                                        -- Kích hoạt thêm các hàm Remote nếu game hỗ trợ
                                        for _, v in ipairs(tool:GetDescendants()) do
                                            if v:IsA("RemoteEvent") then
                                                v:FireServer(eChar)
                                            end
                                        end
                                    end)
                                end
                                task.wait(0.05)
                                hrp.CFrame = oldPos
                            end
                        end
                    end
                end
                task.wait(0.2)
            end
            
            kStroke.Color = Color3.fromRGB(255, 69, 0)
            KillBtn.TextColor3 = Color3.fromRGB(255, 69, 0)
            KillBtn.Text = "⚡ KÍCH HOẠT KILL ALL"
        end)
    else
        isKilling = false
    end
end)

print("Meme Hub Kill All đã sẵn sàng!")
      
